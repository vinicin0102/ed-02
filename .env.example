# Credenciais da ZuckPay
# Painel ZuckPay > Desenvolvedores > Credenciais API
ZUCKPAY_CLIENT_ID=""
ZUCKPAY_CLIENT_SECRET=""

# Opcional - padrao https://www.zuckpay.com.br/conta
# (precisa do "www": sem ele o CDN faz 301 e transforma o POST em GET)
ZUCKPAY_BASE_URL=""

# Opcional - URL publica https que recebe o postback da ZuckPay.
# Sem ela o pagamento ainda e confirmado, porque a pagina consulta
# GET /v3/pix/status a cada 4s enquanto o PIX esta pendente.
ZUCKPAY_WEBHOOK_URL=""

# Porta do servidor local (padrao 9000)
PORT=""

# Como subir com essas variaveis:
#   cp .env.example .env   # e preencha
#   node --env-file=.env server.js
